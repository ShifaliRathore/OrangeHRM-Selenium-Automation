    <test name="Time and Dashboard Tests">
        <classes>
            <class name="orangehrm.tests.TimeModuleTest"/>
        </classes>
    </test>

    <test name="Dashboard Tests">
        <classes>
            <class name="orangehrm.tests.DashboardTest"/>
        </classes>
    </test>

    <!--    <test name="Leave Module Tests">-->
    <!--        <classes>-->
    <!--            <class name="orangehrm.tests.LeaveModuleTest"/>-->
    <!--        </classes>-->
    <!--    </test>-->

