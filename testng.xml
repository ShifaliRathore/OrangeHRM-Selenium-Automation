        <classes>
            <class name="orangehrm.tests.RecruitmentTest"/>
            <class name="orangehrm.tests.RecruitmentValidationTest"/>
        </classes>
    </test>

    <test name="Leave Config Tests">
        <classes>
            <class name="orangehrm.tests.LeaveConfigTest"/>
        </classes>
    </test>

